    {
      "@id": "https://wilkinsonlab.github.io/FLAIR-GG/#project",
      "@type": "ResearchProject",
      "name": "FLAIR-GG",
      "alternateName": "FLAIR-GG: Connecting Germplasm Resources",
      "description": "FLAIR-GG is a federated network of FAIR plant germplasm banks and related biodiversity resources. Each member publishes DCAT metadata from its own FAIR Data Point; the FLAIR-GG FDP Index harvests them, and the FLAIR-GG Virtual Platform federates search, data services and analysis across the network, including through a Model Context Protocol (MCP) server for AI assistants.",
      "url": "https://wilkinsonlab.github.io/FLAIR-GG/",
      "logo": "https://wilkinsonlab.github.io/FLAIR-GG/VP/images/flair-gg-logo.png",
      "sameAs": [ "https://github.com/wilkinsonlab/FLAIR-GG" ],
      "keywords": [
        "FAIR data", "germplasm", "plant genetic resources", "seed banks", "DCAT", "FAIR Data Point",
        "federated query", "linked data", "RDF", "SPARQL", "Multi-Crop Passport Descriptors",
        "Model Context Protocol"
